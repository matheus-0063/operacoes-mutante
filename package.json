{
  "name": "operacoes-mutante-lab",
  "version": "1.0.0",
  "description": "Projeto base para o trabalho de Teste de Mutação com StrykerJS.",
  "main": "src/operacoes.js",
  "type": "commonjs",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "test": "jest --runInBand",
    "test:inicial": "jest --runInBand --runTestsByPath test/operacoes.test.js",
    "coverage": "jest --runInBand --coverage --coverageDirectory=coverage/final",
    "coverage:inicial": "jest --runInBand --runTestsByPath test/operacoes.test.js --coverage --coverageDirectory=coverage/inicial",
    "mutate": "stryker run stryker.conf.json",
    "mutate:inicial": "stryker run stryker.inicial.conf.cjs",
    "resultados": "node scripts/resumir-resultados.cjs",
    "analisar": "npm run coverage:inicial && npm run mutate:inicial && npm run coverage && npm run mutate && npm run resultados",
    "relatorio": "python3 scripts/gerar-relatorio.py"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  }
}
