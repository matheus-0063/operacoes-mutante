{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/operacoes.js"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.cjs"
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/final/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/final/mutation.json" },
  "concurrency": 2,
  "timeoutMS": 1000,
  "thresholds": { "high": 98, "low": 80, "break": 0 },
  "ignorePatterns": ["coverage", "reports", "output", "docs", "scripts", "tmp"]
}
